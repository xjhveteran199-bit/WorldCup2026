<view class="wrap">
  <view class="head">
    <view class="logo">🐙 <text class="logo-grad">硅基看球</text></view>
    <view class="tagline">碳基看球，硅基算球 · 🧠 深度学习预测引擎</view>
    <view class="live-chip">⚽ 2026 世界杯 · 开战中 LIVE</view>
    <view class="dl-chip">🧠 神经网络模型 · 约5万场比赛训练 · 判别式预测仅出概率</view>
  </view>

  <!-- 对阵选择 -->
  <view class="card">
    <view class="card-h">⚔️ 选择对阵</view>
    <view class="vs-row">
      <view class="side">
        <view class="flag">{{aFlag}}</view>
        <picker range="{{teamList}}" range-key="label" value="{{idxA}}" bindchange="onPickA">
          <view class="picker">{{aZh}} ▾</view>
        </picker>
        <view class="meta">{{aMeta}}</view>
      </view>
      <view class="vs">VS</view>
      <view class="side">
        <view class="flag">{{bFlag}}</view>
        <picker range="{{teamList}}" range-key="label" value="{{idxB}}" bindchange="onPickB">
          <view class="picker">{{bZh}} ▾</view>
        </picker>
        <view class="meta">{{bMeta}}</view>
      </view>
    </view>
    <view class="mode-row">
      <view class="mode {{!knockout?'on':''}}" data-ko="0" bindtap="setMode">小组赛</view>
      <view class="mode {{knockout?'on':''}}" data-ko="1" bindtap="setMode">淘汰赛(含点球)</view>
    </view>
    <button class="btn" bindtap="predict">🔥 开赛！立即预测</button>
  </view>

  <block wx:if="{{result}}">
    <!-- 统计预测 -->
    <view class="card">
      <view class="card-h">📊 预测结果 <text class="tag" style="border-color:#ff3d2e;color:#ff8a5e">🧠 深度学习模型</text></view>
      <view class="prob-bar">
        <view class="seg w" style="width:{{result.wWidth}}%">{{result.pW}}</view>
        <view class="seg d" style="width:{{result.dWidth}}%">{{result.pD}}</view>
        <view class="seg l" style="width:{{result.lWidth}}%">{{result.pL}}</view>
      </view>
      <view class="prob-legend">
        <text>{{aZh}} 胜</text><text>平</text><text>{{bZh}} 胜</text>
      </view>
      <view class="big-wrap">
        <view class="big-score">{{result.bigScore}}</view>
        <view class="big-lab">模型最可能比分</view>
      </view>
      <view class="top-scores">
        <view class="ts" wx:for="{{result.topScores}}" wx:key="s">{{item.s}} <text class="ts-p">{{item.p}}</text></view>
      </view>
      <view class="ko-line" wx:if="{{result.koLine}}">{{result.koLine}}</view>
      <view class="hint" style="margin-top:12rpx">⚽ 足球单场变数大，概率仅供参考，不构成竞彩建议。模型长期真实战绩与校准见底部「🔬 模型」页 📊。</view>
    </view>

    <!-- 热力图 -->
    <view class="card">
      <view class="card-h">🌡️ 比分概率热力图</view>
      <view class="heat">
        <view class="heat-row">
          <view class="hc hh">{{aFlag}}\{{bFlag}}</view>
          <view class="hc hh" wx:for="{{[0,1,2,3,4,5]}}" wx:key="*this">{{item}}</view>
        </view>
        <view class="heat-row" wx:for="{{result.heat}}" wx:for-index="x" wx:key="x">
          <view class="hc hh">{{x}}</view>
          <view class="hc" wx:for="{{item}}" wx:for-item="cell" wx:for-index="y" wx:key="y" style="background:{{cell.col}}">{{cell.v}}</view>
        </view>
      </view>
      <view class="hint" style="text-align:center">行={{aZh}}进球 · 列={{bZh}}进球 · 越亮概率越高</view>
    </view>

    <!-- 六维对比 -->
    <view class="card">
      <view class="card-h">📐 六维实力对比</view>
      <view class="dim" wx:for="{{result.dims}}" wx:key="name">
        <view class="dim-name">{{item.name}}</view>
        <view class="dim-bars">
          <view class="dim-bar-l"><view class="fill-a" style="width:{{item.a}}%"></view></view>
          <view class="dim-vs"></view>
          <view class="dim-bar-r"><view class="fill-b" style="width:{{item.b}}%"></view></view>
        </view>
        <view class="dim-val"><text class="va">{{item.a}}</text><text class="vb">{{item.b}}</text></view>
      </view>
      <view class="dim-legend"><text class="da">● {{aZh}}</text><text class="db">● {{bZh}}</text></view>
    </view>

    <!-- 因子 -->
    <view class="card">
      <view class="card-h">🧮 修正因子明细 <text class="tag">透明可复现</text></view>
      <view class="factor" wx:for="{{result.factors}}" wx:key="k">
        <text class="fk">{{item.k}}</text><text class="fv {{item.cls}}">{{item.v}}</text>
      </view>
    </view>

    <!-- 分享卡片 -->
    <button class="btn" style="margin:16rpx 0" bindtap="makeCard">📸 生成小红书分享卡片</button>
    <view class="share-box" wx:if="{{sharePath}}">
      <image src="{{sharePath}}" mode="widthFix" class="share-img"></image>
      <button class="btn btn-ghost" bindtap="saveCard">⬇️ 保存到相册</button>
      <view class="hint" style="text-align:center;margin-top:10rpx">保存后发小红书 📕 · 右上角「···」可转发好友</view>
    </view>
  </block>

  <view class="disclaimer">
    <view>🐙 硅基看球 · 碳基看球，硅基算球</view>
    <view>数据更新 {{dataDate}} · 已录入 {{resultsCount}} 场赛果 · 小红书 <text class="em">@碳化硅SiC</text></view>
    <view>预测仅供娱乐参考，不构成任何竞彩建议。理性看球，热爱足球。</view>
  </view>
</view>
